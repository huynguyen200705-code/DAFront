# ==============================================================================
# CẤU HÌNH KẾT NỐI SONG SONG: LOCAL WEB API & CLOUD WEB API (RENDER.COM)
# ==============================================================================
# Hệ thống hỗ trợ chạy song song cả 2 chế độ:
# 1. LOCAL (Máy tính): Chạy qua file run.bat, kết nối siêu nhanh trong cùng Wi-Fi.
# 2. CLOUD (Render/Railway): Chạy 24/7 trực tuyến, kết nối bằng 4G/Wi-Fi bất kỳ.
# ==============================================================================

# [1] Local Web API (Wi-Fi máy tính hiện tại):
LOCAL_URL=http://192.168.0.172:5276/api/

# [2] Cloud Web API (Deploy trên Render.com - Chạy 24/7 không cần bật PC):
# Điền link Render của bạn vào đây khi deploy xong (ví dụ: https://da-restaurant-api.onrender.com/api/)
CLOUD_URL=https://da-restaurant-api.onrender.com/api/

# [3] Android Emulator:
EMULATOR_URL=http://10.0.2.2:5276/api/

# [4] Radmin VPN:
RADMIN_URL=http://26.38.230.253:5276/api/

# URL mặc định khi khởi động ứng dụng:
BASE_URL=http://192.168.0.172:5276/api/
